ADMIN_EMAIL=
# Copy this file to .env in the project root (next to server.ts).
# Set both values from the Razorpay Dashboard with Test Mode enabled.
# Restart the API after changing either value. Never add the secret to VITE_* variables.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
